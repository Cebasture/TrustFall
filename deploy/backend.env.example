# Backend environment — deployed to /opt/task-manager-backend/.env
# db.js hardcodes the DB password ("johnPassword!@#$%") and host (127.0.0.1);
# only the following are read from the environment.
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string-0a1b2c3d4e5f
DB_USER=john
DB_NAME=userdb
NODE_ENV=production
